# Copy this file to .env and fill in real values:
#   cp backend/.env.example backend/.env
# .env is gitignored — never commit it.

# --- Database ---------------------------------------------------------------
# Matches the postgres service in docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5433/readledger

# --- Auth -------------------------------------------------------------------
# REQUIRED. The app refuses to start if this is missing, left as the placeholder
# below, or shorter than 32 characters — signing JWTs with a value that appears
# in the repo would let anyone forge a token for any user.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace-with-a-random-32-byte-string
ALGORITHM=HS256

# --- LLM: Azure OpenAI (primary path) ---------------------------------------
# All four are required together for the Azure provider to activate.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# --- LLM: OpenAI (fallback, used only if Azure vars are unset) --------------
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-4
# LLM_TEMPERATURE=0.0

# --- External APIs ----------------------------------------------------------
# Optional: Google Books works unauthenticated at low volume, but quota is
# much lower without a key. https://console.cloud.google.com/apis/credentials
GOOGLE_BOOKS_API_KEY=your-google-books-key
